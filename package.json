{
  "name": "astro-navfolio",
  "type": "module",
  "version": "0.2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "fonts:ui": "bun scripts/fonts/subset-ui-font.ts",
    "build": "bun run fonts:ui && astro build && pagefind --site dist --output-subdir pagefind --root-selector main --exclude-selectors \"[data-pagefind-ignore]\"",
    "preview": "astro preview",
    "docs:dev": "NAVFOLIO_CONTENT_SOURCE=docs astro dev",
    "docs:build": "NAVFOLIO_CONTENT_SOURCE=docs bun run build",
    "docs:preview": "NAVFOLIO_CONTENT_SOURCE=docs astro preview",
    "docs:sync": "git submodule update --init --recursive",
    "astro": "astro",
    "content:new": "bun scripts/new-content.ts",
    "post:new": "bun scripts/new-content.ts post",
    "project:new": "bun scripts/new-content.ts project",
    "vibe:new": "bun scripts/new-content.ts vibe",
    "media:new": "bun scripts/new-content.ts media",
    "lint": "eslint .",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "bun run lint && prettier --check --ignore-unknown .",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@expressive-code/plugin-collapsible-sections": "^0.44.1",
    "@expressive-code/plugin-line-numbers": "^0.44.1",
    "@fontsource/maple-mono": "^5.3.0",
    "@navfolio/core": "github:navfolio/core",
    "@navfolio/mdx-components": "github:navfolio/mdx-components",
    "@navfolio/pages": "github:navfolio/pages",
    "@navfolio/plugin-markdown": "github:navfolio/plugin-markdown",
    "@navfolio/theme-default": "github:navfolio/theme-default",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.4",
    "astro-expressive-code": "^0.44.1",
    "date-fns": "^4.4.0",
    "github-slugger": "^2.0.0",
    "katex": "^0.18.1",
    "lucide-astro": "^0.556.0",
    "mermaid": "^11.16.0",
    "sharp": "^0.35.3",
    "smol-toml": "^1.7.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/compiler": "^4.0.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*": "bun run format:check"
  }
}
